{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npx vitest*)",
      "Bash(npx oxlint*)",
      "Bash(npx tsc*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec backend php bin/phpunit*)",
      "Bash(docker compose exec backend php bin/console debug:*)",
      "Bash(docker compose exec backend php bin/console lint:*)",
      "Bash(docker compose exec backend php bin/console doctrine:schema:validate*)",
      "Bash(docker compose exec backend php bin/console doctrine:migrations:status*)",
      "Bash(docker compose exec backend vendor/bin/rector process --dry-run*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm run deploy*)",
      "Bash(npx wrangler deploy*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./backend/.env.local)",
      "Read(./backend/.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_tool_use.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/post_tool_use.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
